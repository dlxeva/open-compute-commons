{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-compute-commons.example/schemas/core/action.schema.json",
  "title": "OCC Action (v0.2 core, candidate draft)",
  "$comment": "spec/PROTOCOL_v0.2.md §2.2 / §3.1。候选语义契约，非线上系统。MUST NOT 包含任何凭据或第三方账号标识。",
  "type": "object",
  "required": ["action_id", "version", "status", "title", "purpose", "data_policy", "execution_policy", "created_at"],
  "properties": {
    "action_id": { "type": "string", "pattern": "^act-[A-Za-z0-9_-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,2}$" },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "open", "executing", "validating", "releasing", "closed", "suspended", "cancelled", "archived"]
    },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "synthetic": { "type": "boolean", "description": "true 表示合成演示，非真实行动" },
    "created_at": { "type": "string", "format": "date-time" },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "requester_ref": { "type": "string", "description": "需求方引用；假名或组织占位符" },
    "coordinator_ref": { "type": "string" },
    "result_license": { "type": "string" },
    "acceptance_policy_ref": { "type": "string" },
    "status_reason_code": { "type": "string", "description": "suspended/cancelled 时的理由码" },
    "data_policy": {
      "type": "object",
      "required": ["sensitivity_level", "license", "authorization_ref", "redistribution_allowed", "pii_present"],
      "properties": {
        "sensitivity_level": { "type": "string", "enum": ["L0", "L1", "L2", "L3"] },
        "license": { "type": "string" },
        "authorization_ref": { "type": "string" },
        "redistribution_allowed": { "type": "boolean" },
        "pii_present": { "type": "boolean" },
        "retention_policy": { "type": "string" },
        "egress_constraints": { "type": "string" }
      },
      "additionalProperties": false
    },
    "execution_policy": {
      "type": "object",
      "required": ["execution_locus", "third_party_inference_possible", "account_custody"],
      "properties": {
        "execution_locus": {
          "type": "string",
          "enum": ["participant_self_controlled", "institution_controlled"]
        },
        "third_party_inference_possible": { "type": "boolean" },
        "account_custody": {
          "type": "string",
          "enum": ["participant_self_custody"],
          "description": "固定值。项目 MUST NOT 代管账号（PROTOCOL_v0.2 §9.3）。"
        },
        "allowed_tooling": { "type": "array", "items": { "type": "string" } },
        "reproducibility_requirements": { "type": "string" },
        "usage_reporting": { "type": "string", "enum": ["none", "coarse_range", "per_attempt"] }
      },
      "additionalProperties": false
    },
    "adoption_commitment": {
      "type": "object",
      "description": "Optional demand-side commitment (docs/DEMAND_COMMITMENT.md). When present, all five items are required. Describe each item only at a publicly shareable level: roles, not personal names; public systems or pages, not private links. A candidate need missing any item is not selected. Stating a commitment is not impact evidence (spec/CONTRIBUTION_v0.1.md §3.3).",
      "required": ["result_destination", "expected_publication", "acceptance_role", "adoption_signoff_role", "output_schema_signoff", "manual_baseline"],
      "properties": {
        "result_destination": { "type": "string", "minLength": 1, "description": "Item 1: where accepted results land (system, page, catalogue or dataset), at a publicly shareable level." },
        "expected_publication": { "type": "string", "minLength": 1, "description": "Item 2: when results will be published or used, relative to acceptance (e.g. 'within 4 weeks after acceptance')." },
        "acceptance_role": { "type": "string", "minLength": 1, "description": "Item 3a: the role that accepts units. A role, not a personal name." },
        "adoption_signoff_role": { "type": "string", "minLength": 1, "description": "Item 3b: the role authorized to sign off adoption. A role, not a personal name." },
        "output_schema_signoff": {
          "type": "object",
          "description": "Item 4: the requester's confirmation of the output schema.",
          "required": ["output_schema_ref", "confirmed_by_role"],
          "properties": {
            "output_schema_ref": { "type": "string", "minLength": 1 },
            "confirmed_by_role": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "manual_baseline": {
          "type": "object",
          "description": "Item 5: requester's own minutes per unit by hand, as a range with a basis level. Basis 'unknown' is not allowed: an unknown baseline counts as a missing item.",
          "required": ["minutes_per_unit_p50", "basis"],
          "properties": {
            "minutes_per_unit_p50": { "type": "number", "minimum": 0 },
            "minutes_per_unit_p90": { "type": "number", "minimum": 0 },
            "basis": { "type": "string", "enum": ["measured", "calibrated", "assumed"] }
          },
          "additionalProperties": false
        },
        "recorded_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
