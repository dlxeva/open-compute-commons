{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-compute-commons.example/schemas/core/validation.schema.json",
  "title": "OCC Validation (v0.2 core, candidate draft)",
  "$comment": "四层验证之一层。spec/PROTOCOL_v0.2.md §2.9 / §6。append-only；改判 MUST 通过新记录并填 supersedes，MUST NOT 原地覆盖。",
  "type": "object",
  "required": ["validation_id", "submission_id", "layer", "verdict", "decided_at"],
  "properties": {
    "validation_id": { "type": "string", "pattern": "^val-[A-Za-z0-9_-]+$" },
    "submission_id": { "type": "string", "pattern": "^sub-[A-Za-z0-9_-]+$" },
    "layer": {
      "type": "string",
      "enum": ["L1_schema", "L2_rule", "L3_crosscheck", "L4_human"]
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "partial", "inconclusive", "skipped"],
      "$comment": "前层 fail 导致后层未执行时 MUST 记 skipped，MUST NOT 记 pass。"
    },
    "decided_at": { "type": "string", "format": "date-time" },
    "synthetic": { "type": "boolean" },
    "validator_ref": {
      "type": "string",
      "$comment": "自动层为工具标识；人工层为假名。MUST NOT 为被验证者本人（自证禁止）。"
    },
    "automated": { "type": "boolean" },
    "sample_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "$comment": "L4 抽检比例。外推 MUST 显式标注。"
    },
    "extrapolated": { "type": "boolean" },
    "supersedes": { "type": "string", "pattern": "^val-[A-Za-z0-9_-]+$" },
    "error_codes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^E_[A-Z_]+$" }
    },
    "per_unit_verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit_id", "verdict"],
        "properties": {
          "unit_id": { "type": "string", "pattern": "^unit-[A-Za-z0-9_-]+$" },
          "verdict": { "type": "string", "enum": ["pass", "fail", "inconclusive", "skipped", "not_selected"] },
          "error_codes": {
            "type": "array",
            "items": { "type": "string", "pattern": "^E_[A-Z_]+$" }
          },
          "redline_hit": { "type": "boolean" },
          "measured": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
